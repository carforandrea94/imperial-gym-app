rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Il coach a cui questo utente e' agganciato. Costa una lettura, quindi
    // vale la pena solo dove il documento in gioco non porta gia' il coachId
    // con se' (le sottoraccolte, che sono dati del cliente e basta).
    function isCoachOf(uid) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(uid)).data.coachId == request.auth.uid;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // I soli campi del profilo che l'utente cambia da solo: altezza, sesso
    // e data di nascita.
    // Si dichiarano una volta e restano, quindi vivono sul profilo e non fra
    // le misurazioni. La forbice dell'altezza e i due valori del sesso sono
    // ripetuti qui e non solo nel client perche' la validazione dell'app e' un
    // suggerimento: a scrivere sul documento e' il dispositivo, non l'app.
    function bodyFieldsOnly() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['heightCm', 'sex', 'birthDate']) &&
        (!keys.hasAny(['heightCm']) || request.resource.data.heightCm == null || (
          request.resource.data.heightCm is number &&
          request.resource.data.heightCm >= 100 &&
          request.resource.data.heightCm <= 250
        )) &&
        (!keys.hasAny(['sex']) || request.resource.data.sex == null ||
          request.resource.data.sex in ['m', 'f']) &&
        // Solo la forma, non la plausibilita': il giorno esatto non e' affare
        // delle regole, ma una stringa di dieci caratteri in quel formato si'.
        (!keys.hasAny(['birthDate']) || request.resource.data.birthDate == null || (
          request.resource.data.birthDate is string &&
          request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        ));
    }

    match /users/{uid} {
      // Un utente legge il proprio profilo; un coach legge i profili dei propri client.
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        resource.data.coachId == request.auth.uid
      );

      // Creazione: solo il proprio documento, in fase di registrazione/creazione account.
      // Un coach si autodichiara coach (coachId nullo); un client viene creato con un
      // coachId gia' valorizzato (assegnato dal coach che lo crea).
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        (
          (request.resource.data.role == 'coach' && request.resource.data.coachId == null) ||
          (request.resource.data.role == 'client' && request.resource.data.coachId is string)
        );

      // Update: il client puo' completare l'accoppiamento (paired false -> true)
      // e dichiarare altezza, sesso e data di nascita; il coach puo' aggiornare
      // i documenti dei
      // propri client (usi futuri).
      allow update: if isSignedIn() && (
        (request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paired']) &&
          resource.data.paired == false && request.resource.data.paired == true) ||
        (request.auth.uid == uid && bodyFieldsOnly()) ||
        (resource.data.coachId == request.auth.uid)
      );

      // Chiudere un account: il proprio, o quello di un proprio cliente.
      // Le sottoraccolte non se ne vanno da sole - Firestore non cancella a
      // cascata - quindi l'app le svuota PRIMA del documento. Non e' un
      // dettaglio: cancellato il profilo, isCoachOf() qui sotto non trova piu'
      // il coachId e quei documenti diventerebbero indelebili per sempre.
      allow delete: if isSignedIn() && (
        request.auth.uid == uid ||
        resource.data.coachId == request.auth.uid
      );

      // Dati personali del client: allenamenti salvati, uscite di corsa,
      // misurazioni, stato/bozze. Li scrive solo il proprietario.
      //
      // Il coach li legge e li cancella, ma solo per i propri clienti: quando
      // rimuove un cliente deve poter cancellare anche questi, e per cancellare
      // un insieme di documenti bisogna prima leggerli - una query li restituisce
      // per intero, non esiste "elenca senza vedere". E' un allargamento vero di
      // cosa il coach vede, deciso apposta.
      match /sessions/{id} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
        allow read, delete: if isCoachOf(uid);
      }
      match /runs/{id} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
        allow read, delete: if isCoachOf(uid);
      }
      match /measurements/{id} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
        allow read, delete: if isCoachOf(uid);
      }
      match /state/{id} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
        allow read, delete: if isCoachOf(uid);
      }

      // Protocolli (scheda + dieta) creati dal coach per questo client.
      // Il client puo' solo leggere (li vede in Scheda/Dieta); solo il
      // coach proprietario di questo client puo' crearli/modificarli.
      match /protocols/{id} {
        allow read: if isSignedIn() && (
          request.auth.uid == uid ||
          get(/databases/$(database)/documents/users/$(uid)).data.coachId == request.auth.uid
        );
        allow write: if isSignedIn() &&
          get(/databases/$(database)/documents/users/$(uid)).data.coachId == request.auth.uid;
        // Il client non scrive i propri protocolli, ma se ne va con loro:
        // chiudendo l'account deve poterli portare via, altrimenti resterebbero
        // orfani sotto un utente che non esiste piu'.
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /announcements/{id} {
      // Il coach legge i propri avvisi; un client legge gli avvisi del proprio coach.
      allow read: if isSignedIn() && (
        resource.data.coachId == request.auth.uid ||
        myProfile().coachId == resource.data.coachId
      );
      allow create: if isSignedIn() && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.coachId == request.auth.uid;
    }

    // Mappa pubblica codice-coach -> uid coach. Serve al client per trovare il proprio
    // coach in fase di registrazione, PRIMA di avere un account (quindi lettura libera).
    // Non contiene dati personali, solo il riferimento all'uid del coach.
    match /coachCodes/{code} {
      // get e non read: `read` comprende anche `list`, e con la raccolta
      // elencabile chiunque, senza nemmeno un account, si scaricava tutti i
      // codici e gli uid dei coach - e poi si iscriveva come cliente di uno
      // qualsiasi senza essere mai stato invitato. Verificato dall'esterno.
      // L'app cerca sempre un codice preciso (getDoc), quindi non perde niente.
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.coachId;
      allow update: if false;
      // Il coach si porta via il proprio codice quando chiude l'account: se
      // restasse, chi lo usasse si iscriverebbe a un coach che non c'e' piu'.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.coachId;
    }
  }
}
